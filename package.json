{
  "name": "leanloop-kit",
  "version": "0.4.0",
  "description": "A local, single-owner engineering workflow for AI coding agents: bounded context, bounded memory, overhead audit, and evidence-based completion.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "leanloop": "bin/leanloop.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "skills/",
    "agents/",
    "docs/",
    "scripts/",
    "tests/",
    "plugin.json",
    "AGENTS.md",
    "README.md",
    "SOURCES.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-package.mjs",
    "benchmark": "node scripts/benchmark-context.mjs",
    "benchmark:repo": "node scripts/benchmark-large-repo.mjs"
  }
}
