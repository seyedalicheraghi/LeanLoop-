{
  "name": "leanloop-kit",
  "version": "0.5.1",
  "description": "A Claude Code plugin for single-owner, evidence-gated engineering: bounded context and memory, test-integrity review, and a setup overhead audit.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "leanloop": "leanloop.mjs"
  },
  "files": [
    ".claude-plugin/",
    "leanloop.mjs",
    "lib/",
    "skills/",
    "agents/",
    "docs/",
    "scripts/",
    "tests/",
    "AGENTS.md",
    "README.md",
    "SOURCES.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-package.mjs",
    "benchmark": "node scripts/benchmark-context.mjs",
    "benchmark:repo": "node scripts/benchmark-large-repo.mjs"
  }
}
